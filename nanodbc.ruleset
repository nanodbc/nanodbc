<?xml version="1.0" encoding="utf-8"?>
<!--
  The C++ Core Guidelines checks, less the ones whose only remedy is the Guidelines Support
  Library. nanodbc is distributed as a header and an implementation file that can be dropped
  into a project, so taking on a dependency to satisfy an analyser is not a trade it can make.
  Each rule below is turned off for that reason alone, and anything answerable with the
  standard library or by restructuring is left switched on.
-->
<RuleSet Name="nanodbc" Description="C++ Core Guidelines checks that do not require the GSL" ToolsVersion="17.0">
  <Include Path="cppcorecheckrules.ruleset" Action="Default" />
  <Rules AnalyzerId="Microsoft.Analyzers.NativeCodeAnalysis" RuleNamespace="Microsoft.Rules.Native">
    <!-- bounds.4: prefer gsl::at() to the subscript operator. -->
    <Rule Id="C26446" Action="None" />
    <!-- bounds.2: only index into arrays using constant expressions, gsl::span otherwise. -->
    <Rule Id="C26482" Action="None" />
    <!-- bounds.1: no pointer arithmetic, use gsl::span. The ODBC buffers are C arrays
         handed to a C API, which is the shape the driver manager requires. -->
    <Rule Id="C26481" Action="None" />
    <!-- bounds.3: no array to pointer decay, use gsl::span. Same reason. -->
    <Rule Id="C26485" Action="None" />
    <!-- type.1: use gsl::narrow or gsl::narrow_cast rather than static_cast for an
         arithmetic conversion. Worth revisiting: a narrow_cast of nanodbc's own may
         satisfy the intent, if not the checker. -->
    <Rule Id="C26472" Action="None" />
  </Rules>
</RuleSet>
